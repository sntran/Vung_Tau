; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Vũng Tàu"
config/description="A game about Vietnamese food and daily life in a hẻm in Vũng Tàu."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.0627451, 0.129412, 0.117647, 1)
config/icon="res://icon.svg"

[audio]

driver/enable_input=false

[autoload]

Content="*res://autoload/content.gd"
GameState="*res://autoload/game_state.gd"
Playtest="*res://autoload/playtest.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

theme/custom_font="res://assets/fonts/BeVietnamPro-Regular.ttf"
common/snap_controls_to_pixels=true

[input_devices]

pointing/emulate_mouse_from_touch=true

[physics]

common/physics_interpolation=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0

lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=2048
